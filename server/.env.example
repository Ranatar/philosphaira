# ОБРАЗЕЦ. Значения СЮДА не вписывать: файл лежит в репозитории.
#
# И ещё: этот файл НЕ ЗАГРУЖАЕТСЯ САМ. Точки входа читают process.env
# напрямую, dotenv в зависимостях нет — переменные должны и вправду быть в
# окружении процесса. Образец перечисляет, что нужно, а не подставляет это.

# ── Postgres ────────────────────────────────────────────────────────────
# БАЗА ОБЯЗАНА БЫТЬ В ЛОКАЛИ, СВОРАЧИВАЮЩЕЙ КИРИЛЛИЦУ (C.UTF-8, ru_RU.UTF-8).
# Единственность логина и почты держится на lower(), а в голой локали C
# lower('ИВАН') возвращает 'ИВАН' — и «ИВАН» с «иван» станут разными людьми.
# Проверяет auth_probe.
#   createdb philos --locale=C.UTF-8 --template=template0
DATABASE_URL=postgres://postgres@localhost:5432/philos

# ── HTTP ────────────────────────────────────────────────────────────────
PORT=8814
# production включает cookie только по HTTPS — значит нужен обратный ставень.
NODE_ENV=development

# Разрешённые Origin для сокета, через запятую. Не задано — не проверяем.
# WS_ORIGINS=http://localhost:8814,http://127.0.0.1:8814

# ── Первый администратор ────────────────────────────────────────────────
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid

# Настоящий пароль в репозиторий НЕ КОММИТИТЬ. Требования те же, что при
# обычной регистрации (src/auth/password.js): не короче 12 знаков.
# И не передавайте его доводом командной строки: довод виден в списке
# процессов и остаётся в истории оболочки.
BOOTSTRAP_ADMIN_PASSWORD=

# ── Второй шаг ──────────────────────────────────────────────────────────
# Ключ AES-256-GCM для хранения секретов TOTP: ровно 32 байта в base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Потеряете ключ — потеряете все заведённые вторые шаги.
MFA_SECRET_KEY=

# ── Обратный ставень ────────────────────────────────────────────────────
# Сколько обратных ставней стоит перед узлом. Обычно 1 (nginx или Caddy),
# без ставня — 0. ЗАДАВАТЬ ОБЯЗАТЕЛЬНО при NODE_ENV=production: иначе узел
# не поднимется, и это нарочно. За ставнем без доверия ему req.ip равен
# 127.0.0.1 у ВСЕХ — адреса в user_sessions и audit_log перестают отвечать
# на вопрос «откуда заходили», а предел регистраций бьёт по всем разом.
# Доверять всегда тоже нельзя: без ставня любой присланный X-Forwarded-For
# станет «адресом человека», и журнал начнёт врать по чужой воле.
# TRUST_PROXY=1

# ── Почта ───────────────────────────────────────────────────────────────
# БЕЗ ЭТИХ ДВУХ ОТКРЫТАЯ РЕГИСТРАЦИЯ НЕ РАБОТАЕТ: подтверждение адреса идёт
# письмом, а без подтверждённого адреса права срезаны (NEEDS_VERIFIED_EMAIL).
# Работник говорит об этом вслух при запуске, а не молчит.
#
# Строка подключения к стороннему SMTP. Пароль в репозиторий НЕ КОММИТИТЬ;
# в текст ошибки он не попадает — вычищается (src/notify/mail.js, scrub).
# SMTP_URL=smtps://пользователь:пароль@smtp.поставщик.tld:465
#
# Обратный адрес письма. Домен обязан совпадать с тем, для которого заведены
# SPF, DKIM и DMARC, иначе письма подтверждения уйдут в спам, и сервис будет
# выглядеть сломанным при исправном коде.
# MAIL_FROM=ΦilosΦaira <no-reply@philosphaira.to>
#
# PUBLIC_URL нужен и почте: в него ведёт ссылка отписки из заголовка
# List-Unsubscribe. Без него письма уйдут с отпиской на 127.0.0.1, и человек,
# которому надоели письма, нажмёт «это спам» — а жалобы бьют по всему домену.

# ── Пул ─────────────────────────────────────────────────────────────────
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT=15000

# ── Аварийное ───────────────────────────────────────────────────────────
# Разрешает ПОВТОРНЫЙ перенос графа поверх рабочего состояния. В обычной
# работе не задавать: шесть JSON — это семя, а правки живут в базе.
# ALLOW_GRAPH_REIMPORT=1
