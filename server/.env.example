# Значения СЮДА не вписывать: файл лежит в репозитории. Свои — в .env.
DATABASE_URL=postgres://postgres@localhost:5433/philos?host=/tmp
# База обязана быть в локали, сворачивающей кириллицу (C.UTF-8 и т.п.):
# единственность логина и почты держится на lower(). Проверяет auth_probe.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# Ключ шифрования секретов второго шага: 32 байта в base64.
# Породить: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_SECRET_KEY=
